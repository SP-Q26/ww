n}\n\n.wwl-legal__bar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 14px 24px;\n  background: var(--wwl-charcoal);\n  color: var(--wwl-cream);\n  font-size: 11px;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n}\n\n.wwl-legal__bar span:last-child {\n  color: var(--wwl-gold);\n  font-weight: 600;\n}\n\n.wwl-legal__body { padding: 32px 28px 40px; }\n\n.wwl-legal__eyebrow {\n  font-size: 11px;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  color: var(--wwl-sage);\n  margin-bottom: 8px;\n}\n\n.wwl-legal h1 {\n  font-family: 'Playfair Display', Georgia, serif;\n  font-size: clamp(28px, 5vw, 36px);\n  font-weight: 700;\n  line-height: 1.15;\n  margin-bottom: 12px;\n  color: var(--wwl-charcoal);\n}\n\n.wwl-legal__meta {\n  font-size: 13px;\n  color: var(--wwl-muted);\n  margin-bottom: 24px;\n  padding-bottom: 20px;\n  border-bottom: 1px solid var(--wwl-border);\n}\n\n.wwl-legal h2 {\n  font-family: 'Playfair Display', Georgia, serif;\n  font-size: 20px;\n  font-weight: 600;\n  margin: 28px 0 12px;\n  color: var(--wwl-charcoal);\n}\n\n.wwl-legal h2 .num {\n  color: var(--wwl-gold);\n  margin-right: 6px;\n}\n\n.wwl-legal p { margin-bottom: 12px; color: var(--wwl-muted); }\n\n.wwl-legal ul {\n  margin: 0 0 14px 20px;\n  color: var(--wwl-muted);\n}\n\n.wwl-legal li { margin-bottom: 6px; }\n\n.wwl-legal a {\n  color: var(--wwl-gold);\n  text-decoration: underline;\n  text-underline-offset: 2px;\n}\n\n.wwl-legal__back {\n  display: inline-block;\n  margin-top: 32px;\n  font-size: 13px;\n  font-weight: 600;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n  color: var(--wwl-charcoal);\n  text-decoration: none;\n  border-bottom: 1px solid var(--wwl-gold);\n}\n\n.wwl-legal__footer {\n  margin-top: 32px;\n  padding-top: 20px;\n  border-top: 1px solid var(--wwl-border);\n  font-size: 12px;\n  color: var(--wwl-muted);\n}\n\n@media (max-width: 600px) {\n  .wwl-legal__body { padding: 24px 18px 32px; }\n}\n\n.wwl-legal__nav {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  padding: 12px 24px;\n  background: rgba(198, 161, 91, 0.12);\n  border-bottom: 1px solid var(--wwl-border);\n}\n.wwl-legal__nav a {\n  display: inline-flex;\n  align-items: center;\n  min-height: 44px;\n  padding: 8px 14px;\n  border-radius: 999px;\n  border: 1px solid rgba(198, 161, 91, 0.45);\n  background: var(--wwl-white);\n  color: var(--wwl-charcoal);\n  font-size: 12px;\n  font-weight: 600;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  text-decoration: none;\n}\n.wwl-legal__nav a:hover { border-color: var(--wwl-gold); }\n</style>\n  <article class=\"wwl-legal\">\n    <header class=\"wwl-legal__bar\">\n      <span>Whispering Woods Luxe</span>\n      <span>Privacy Policy · v1.0</span>\n    </header>\n    <nav class=\"wwl-legal__nav\" aria-label=\"Legal navigation\"><a href=\"https://whisperingwoodsluxe.com/home\">Home</a><a href=\"https://whisperingwoodsluxe.com/terms\">Terms</a><a href=\"https://whisperingwoodsluxe.com/privacypolicy\">Privacy</a></nav><div class=\"wwl-legal__body\">\n      <p class=\"wwl-legal__eyebrow\">The Estate Senior Experience</p>\n      <h1>Privacy Policy</h1>\n      <p class=\"wwl-legal__meta\">Whispering Woods Luxe · Harvard, Illinois · Effective September 5, 2026 · <a href=\"https://whisperingwoodsluxe.com/terms\">Terms of Service</a></p>\n\n      <h2><span class=\"num\">1.</span> Data We Collect</h2>\n      <p>When you book The Estate Senior Experience, we collect:</p>\n      <ul>\n        <li>Senior Name</li>\n        <li>Senior Email</li>\n        <li>Mom Email</li>\n        <li>Phone Number</li>\n        <li>Preferred Week</li>\n      </ul>\n      <p>Waitlist signups collect email address only.</p>\n\n      <h2><span class=\"num\">2.</span> How We Use Your Data</h2>\n      <p>This information is used <strong>solely</strong> for booking, communication, and event coordination — including confirmations, reminders, balance due notices, and session logistics.</p>\n\n      <h2><span class=\"num\">3.</span> Data Storage &amp; Sharing</h2>\n      <ul>\n        <li>Your information is stored securely in our booking system (<strong>Xano</strong>).</li>\n        <li>We do not sell or share your data with third parties except as required for <strong>payment processing (Stripe)</strong>.</li>\n        <li>Stripe processes payments under its own privacy policy. We do not store credit card numbers on our servers.</li>\n      </ul>\n\n      <h2><span class=\"num\">4.</span> Model Release &amp; Marketing Images</h2>\n      <p>If you grant model release consent at booking, selected session images may be used for portfolio, website, social media, and marketing as described in our <a href=\"https://whisperingwoodsluxe.com/terms\">Terms of Service</a>. You may opt out in writing before your session date.</p>\n\n      <h2><span class=\"num\">5.</span> Your Choices</h2>\n      <p>You may request deletion of your data at any time by emailing <a href=\"mailto:bookings@whisperingwoodsluxe.com\">bookings@whisperingwoodsluxe.com</a>. <strong>Note:</strong> Deleting your data will cancel your booking and forfeit your non-refundable deposit.</p>\n\n      <h2><span class=\"num\">6.</span> Security</h2>\n      <p>We use commercially reasonable measures to protect your information. No method of transmission or storage is completely secure.</p>\n\n      <h2><span class=\"num\">7.</span> Changes</h2>\n      <p>We may update this policy. Continued use after an update constitutes acknowledgment. The effective date above will change when revisions are posted.</p>\n\n      <p class=\"wwl-legal__footer\">Sister sites: <a href=\"https://whisperingwoodsevents.com/?utm_source=ww_luxe&utm_medium=footer&utm_campaign=estate_rebrand_2026\" target=\"_blank\" rel=\"noopener noreferrer\">Whispering Woods Events</a> · <a href=\"https://whisperingwoodsweddings.com/?utm_source=ww_luxe&utm_medium=footer&utm_campaign=estate_rebrand_2026\" target=\"_blank\" rel=\"noopener noreferrer\">Whispering Woods Journal</a><br>Questions? Contact <a href=\"mailto:bookings@whisperingwoodsluxe.com\">bookings@whisperingwoodsluxe.com</a></p>\n      <a class=\"wwl-legal__back\" href=\"https://whisperingwoodsluxe.com/home\">← Back to The Estate Senior Experience</a>\n    </div>\n  </article>\n","refreshOnResize":false}},"name":"Privacy Content","wwObjectBaseId":"6d692ca2-6cdc-4805-aa0c-211102f335d0","libraryComponentBaseId":null,"parentSectionId":"5bcca274-c72c-4cdb-bfa6-2d5738b67ef6","_si":309}},"collections":[],"variables":[],"workflows":[],"formulas":[],"libraryComponents":[]}
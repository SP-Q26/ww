{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/subscribe", "destination": "/api/subscribe.js" },
    { "source": "/api/go", "destination": "/api/go.js" },
    { "source": "/go/venue", "destination": "/api/go?dest=venue" },
    { "source": "/go/luxe", "destination": "/api/go?dest=luxe" },
    { "source": "/go/tour", "destination": "/api/go?dest=tour" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
